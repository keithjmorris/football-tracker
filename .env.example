# Copy this file to .env and fill in the real key. .env is gitignored.
HIGHLIGHTLY_API_KEY=paste-your-key-here

# Optional. Unset means https://sports.highlightly.net/football (All Sports).
# HIGHLIGHTLY_FOOTBALL_BASE=https://sports.highlightly.net/football
# Optional. How often live scores refresh, in seconds. Unset means 20.
# LIVE_CACHE_SECONDS=20
